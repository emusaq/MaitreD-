# ─────────────────────────────────────────────
# Maitred — Environment Variable Reference
# Copy to .env and fill in all values.
# ─────────────────────────────────────────────

# Database
# Full SQLAlchemy URL takes priority over DB_USER / DB_PASSWORD.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/maitred
# DB_USER=postgres
# DB_PASSWORD=postgres

# OpenAI
OPENAI_API_KEY=sk-...

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_NUMBER=+1...
# Set true for local dev to bypass Twilio HMAC webhook signature check.
# NEVER set true in production.
TWILIO_SKIP_VALIDATION=true

# WhatsApp Business API — Template SIDs (Twilio Content API)
# Required for out-of-session staff notifications (confirm / deny / cancel).
# If not set, routes fall back to send_message() with a warning log.
# Submit templates via Twilio Console → Messaging → Content Template Builder.
TWILIO_CONFIRM_TEMPLATE_SID=
TWILIO_DENY_TEMPLATE_SID=
TWILIO_CANCEL_TEMPLATE_SID=

# Staff portal
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Session cookie security
# Set false only for local HTTP dev. Must be true in production (requires HTTPS).
SECURE_COOKIES=false

# Rate limiter
# Redis URL for multi-process safe rate limiting.
# Falls back to in-memory (single-process only) when not set.
REDIS_URL=redis://localhost:6379/0

# Timezone (used in reservation slot generation)
APP_TIMEZONE=America/Mexico_City

# Rate limiting defaults (optional overrides)
# RATE_LIMIT_COUNT=10
# RATE_LIMIT_WINDOW=60
